#!/usr/bin/python3
"""rkllm-serve: entry point for the FastAPI-based rkllm stack (1.3.1-16+).

Validates the interpreter, attaches the packaged sources, then hands over to
the unified CLI (serve / config). Kept as a separate command from the legacy
/usr/bin/rkllm so both stacks can be exercised on one board during the
transition; the legacy entry is retired once the new stack passes board
acceptance.
"""
import sys

if sys.version_info[:2] < (3, 13):
    sys.exit("rkllm-serve: python3 >= 3.13 required (found %d.%d)"
             % sys.version_info[:2])

sys.path.insert(0, "/usr/lib/rkllm/current")

from rkllm.cli import main

if __name__ == "__main__":
    sys.exit(main())
