#!/bin/sh
# prerm for @PACKAGE@
#
# The package ships @SERVER_UNIT@ but never enables it. If an operator enabled
# it by hand, it may still be running when the package is removed: dpkg deletes
# the files, but a running process keeps the old librkllmrt.so mapped and keeps
# holding the NPU until the board is rebooted. So removal has to stop it first.
#
# 2026-10-27 audit P1-4: this script used to call `deb-systemd-helper stop`,
# which is not a valid deb-systemd-helper action (the tool only manages enable
# state). The call failed silently behind `|| true`, so the unit was never
# stopped. Stopping a unit is `deb-systemd-invoke stop` (policy- and
# DPKG_ROOT-aware, provided by the essential init-system-helpers package) or
# plain `systemctl stop`. Both are best-effort: a failure here must never block
# the removal.
set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            if command -v deb-systemd-invoke >/dev/null 2>&1; then
                deb-systemd-invoke stop @SERVER_UNIT@ >/dev/null 2>&1 || true
            elif command -v systemctl >/dev/null 2>&1; then
                systemctl stop @SERVER_UNIT@ >/dev/null 2>&1 || true
            fi
        fi
        # Enable/state bookkeeping is still deb-systemd-helper's job; disabling
        # here keeps the "stop + disable" order deterministic for operators who
        # enabled the unit. `purge` in postrm removes the state file later.
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper disable @SERVER_UNIT@ >/dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
