# <连接器安装目录>/mcp.toml - rkllm-mcp 客户端配置
# 复制本文件为安装目录下的 mcp.toml；连接器默认读取它，密钥不进注册文件。
# 优先级：内置默认 < 本文件 < RKLLM_* 环境变量
#
# 设计原则（A 方案）：模型能力由板端 /health 提供，连接器只保留"客户端约束"
# 与"板端不可达时的冷启动兜底"。启动时连接器会拉取一次 /health，把实测解码
# 速率、上下文长度、输出上限、请求超时写进运行时快照；下面的兜底值只在板端
# 未刷新（老版本 runtime / 板端暂时不可达）时才生效。
#
# 板端提供、无需在此配置（写在 TOML 里也不会被读取）：
#   decode_tok_s / context_len / default_max_tokens / max_tokens_limit /
#   context_margin_tokens / request_timeout_s
# 这些来自板端 /health.perf 与 /health.limits，换模型/换板子自动跟随。

[mcp]
# ---- 目标（必配） --------------------------------------------------------
# 板端 OpenAI 兼容端点（也可用 RKLLM_ENDPOINT 环境变量）
target_endpoint = "http://127.0.0.1:8080/v1"
# 板端 server.api_key（留空表示板端未启用鉴权；也可用 RKLLM_API_KEY）
target_api_key = ""

# ---- 客户端约束（保留，因为板端无从得知调用方会等多久） ------------------
# MCP 调用方的硬超时（秒）。转 job 的阈值 = client_timeout_s − 15。
# 例如 60 → 估算超过 45 s 的任务转后台 job，用 local_llm_job 轮询。
client_timeout_s = 60
# 任务模式：auto=按估算自动选择；always=全部转 job；never=不转 job
task_mode = "auto"

# ---- 冷启动兜底（板端 /health 可达时以板端为准） --------------------------
# 同步调用的单次 HTTP 读超时（秒）；job 读超时按估算自动放宽，不受此值限制。
target_timeout_s = 120
# 生成长度兜底：板端 /health.limits.default_max_tokens 优先。
default_max_tokens = 512

# ---- 工具行为 ------------------------------------------------------------
default_temperature = 0.3
max_result_chars = 20000
batch_max_segments = 20
extract_retries = 2

# ---- 会话（带 session 的 chat 使用） --------------------------------------
# 单会话最大消息数；0 = 不限制
session_max_messages = 0
# 同时保留的会话数上限（LRU 淘汰）
session_max_count = 256
# 会话空闲过期（秒）；0 = 不过期
session_ttl_s = 1800

# 注意：只有 target_endpoint / target_api_key 带 target_ 前缀，其余均为扁平键名，
#   写成 target_client_timeout_s 之类不会生效。
