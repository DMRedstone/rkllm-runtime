# 本机会话记录，不入库
.workbuddy/

# Python
__pycache__/
*.py[cod]

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 构建产物不入库，只发 GitHub Release
交付/*.deb

# 上游 SDK 原始发行包（160 MiB）不入库；精简构建输入（22.6 MiB，388 条目，
# 由 stage() payload 裁剪而来）入库，另一台机器 clone 即可构建。
输入/rknn-llm-release-v1.3.1.tar.gz
输入/*.tar.xz

工具/build/
工具/dist/

# 测试工具链的运行产物（报告、结果、语料）
工具/大模型测试工具链/report*.html
工具/大模型测试工具链/report*.md
# 整个目录排除用 results/*，不用 results/：后者会让下面的白名单失效，
# 而 extra.json 是人工补充数据（板端资源、max_tokens 验证、被测版本），
# 报告靠它才能复现，必须入库。
工具/大模型测试工具链/results/*
!工具/大模型测试工具链/results/extra.json
工具/大模型测试工具链/corpus/
工具/大模型测试工具链/csv/
工具/大模型测试工具链/realworld_samples/

# rsync-backup 测试残留（harness.sh 在脚本目录就地生成，不入库）
工具/脚本/funcs.sh
工具/脚本/harness.log
工具/脚本/t[0-9]*/
工具/脚本/h-*/

# wheel 构建产物（make_mcp_wheel.py 输出，可随时重建）
dist/
新写代码-*.zip

# 所有压缩包不入库；唯一例外：官方 SDK 精简包（构建源料，见 输入/构建资料说明.md）
*.zip
*.tar.gz
*.tar.xz
*.7z
!输入/rknn-llm-release-v1.3.1-minimal.tar.gz

# 所有压缩包不入库；唯一例外：官方 SDK 精简包（构建源料，见 输入/构建资料说明.md）
*.zip
*.tar.gz
*.tar.xz
*.7z
